# Normalize text files while preserving Windows-native source line endings.
* text=auto

*.cs text eol=crlf
*.csproj text eol=crlf
*.config text eol=crlf
*.sln text eol=crlf

*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary assets must never receive line-ending conversion.
*.wav binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
